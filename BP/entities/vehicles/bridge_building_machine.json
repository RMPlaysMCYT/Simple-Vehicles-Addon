          ]
        }
      },
			"simple_vehicles:off_mode": {
        "remove": {
          "component_groups": [
            "simple_vehicles:place_black_concrete",
            "simple_vehicles:mix_time"
          ]
        },
        "add": {
          "component_groups": [
            "simple_vehicles:place_nothing"
          ]
        }
      },
			"simple_vehicles:activated": {
				"add": {
					"component_groups": [
