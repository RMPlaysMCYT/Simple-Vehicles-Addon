      "simple_vehicles:submarine_down": {
        "minecraft:navigation.walk": {
          "can_path_over_water": true,
          "avoid_water": true,
          "avoid_damage_blocks": true,
          "can_sink": true
        },
        "minecraft:physics": {
          "has_gravity": true
        }
