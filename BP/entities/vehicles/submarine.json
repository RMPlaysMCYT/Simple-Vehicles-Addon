            {
              "interact_text": "Fuel It Up!!",
              "on_interact": {
                "event": "simple_vehicles:refuel",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "value": "simple_vehicles:jerry_can"
                    }
                  ]
                }
              },
              "use_item": true
            }
          ]
        },
        "minecraft:rideable": {
          "controlling_seat": 0,
          "crouching_skip_interact": true,
          "family_types": ["player"],
