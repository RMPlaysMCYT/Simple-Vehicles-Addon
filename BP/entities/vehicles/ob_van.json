{
  "format_version": "1.18.30",
  "minecraft:entity": {
    "description": {
      "identifier": "simple_vehicles:ob_van",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": ["item_setpack", "command", "durability", "fuel", "move"]
      },
      "animations": {
        "item_setpack": "controller.animation.vehicle_ride.item_setpack",
        "command": "controller.animation.vehicle.command",
        "move": "controller.animation.vehicle.move",
        "durability": "controller.animation.vehicle.durability",
        "fuel": "controller.animation.simple_vehicles.fuel"
      }
    },
    "component_groups": {
      "minecraft:vehicle": {
        "minecraft:interact": {
          "interactions": [
            {
              "interact_text": "Fuel It Up!!",
              "on_interact": {
                "event": "simple_vehicles:refuel",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "value": "simple_vehicles:gas_nozzle"
                    }
                  ]
                }
              },
              "use_item": false
            },
            {
              "interact_text": "Fuel It Up!!",
              "on_interact": {
                "event": "simple_vehicles:refuel",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "value": "simple_vehicles:jerry_can"
                    }
                  ]
                }
              },
              "use_item": true
            }
          ]
        },
        "minecraft:is_tamed": {},
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": false,
          "family_types": ["player", "villager", "cat", "npc"],
          "interact_text": "Drive",
          "pull_in_entities": true,
          "seats": [
            {
              "position": [0.75, 0.9, 2]
            }
          ]
        }
      },
      "minecraft:bugfixer": {
        "minecraft:timer": {
          "time": [0.1, 0.1],
          "looping": false,
          "time_down_event": {
            "event": "minecraft:bugfix",
            "target": "self"
          }
        }
      },
      "minecraft:horse_saddled": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "has_tag",
                    "operator": "equals",
                    "value": "remove"
                  },
                  {
                    "test": "hourly_clock_time",
                    "operator": ">=",
                    "value": 0
                  },
                  {
                    "test": "hourly_clock_time",
                    "operator": "<",
                    "value": 12000
                  }
                ]
              },
              "event": "simple_vehicles:light_off"
            },
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "hourly_clock_time",
                            "operator": ">=",
                            "value": 12000
                          },
                          {
                            "test": "hourly_clock_time",
                            "operator": "<",
                            "value": 24000
                          }
                        ]
                      },
                      {
                        "test": "light_level",
                        "operator": "<",
                        "value": 8
                      }
                    ]
                  },
                  {
                    "test": "has_tag",
                    "operator": "not",
                    "value": "remove"
                  }
                ]
              },
              "event": "simple_vehicles:light_on"
            }
          ]
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:can_power_jump": {},
        "minecraft:behavior.player_ride_tamed": {}
      },
      "simple_vehicles:refuel": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "simple_vehicles:refueled": {
        "minecraft:variant": {
          "value": 1
        }
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "math.min(query.player_level*7,100)"
      },
      "minecraft:scale": {
        "value": 1
      },
      "minecraft:equippable": {
        "slots": [
          {
            "slot": 0,
            "item": "simple_vehicles:key_ob_van",
            "accepted_items": ["simple_vehicles:key_ob_van"],
            "on_equip": {
              "event": "minecraft:horse_saddled"
            },
            "on_unequip": {
              "event": "minecraft:horse_unsaddled"
            }
          }
        ]
      },
      "minecraft:type_family": {
        "family": ["aspire", "ob_van", "simple_vehicles"]
      },
      "minecraft:horse.jump_strength": {
        "value": 0.5
      },
      "minecraft:breathable": {
        "totalSupply": 10,
        "suffocateTime": 0
      },
      "minecraft:is_chested": {},
      "minecraft:collision_box": {
        "width": 3,
        "height": 2
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/ob_van.json"
      },
      "minecraft:health": {
        "value": {
          "range_min": 120,
          "range_max": 120
        }
      },
      "minecraft:inventory": {
        "inventory_size": 15,
        "container_type": "horse",
        "private": false
      },
      "minecraft:movement": {
        "value": {
          "range_min": 0.2,
          "range_max": 0.22
        }
      },
      "minecraft:physics": {
        "has_gravity": true
      },
      "minecraft:fire_immune": true,
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },
      "minecraft:navigation.walk": {
        "can_float": true,
        "avoid_water": false
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:walk_animation_speed": {
        "value": 20
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 100,
            "add": {
              "component_groups": ["minecraft:vehicle"]
            }
          }
        ]
      },
      "minecraft:horse_saddled": {
        "add": {
          "component_groups": ["minecraft:horse_saddled"]
        },
        "queue_command": {
          "command": [
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "setblock ~~1~ light_block 13 keep",
            "fill ~-3~-2~-3 ~3~-1~3 air 0 replace light_block 13",
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "fill ~-3~-2~-3 ~-2~4~3 air 0 replace light_block 13",
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13"
          ]
        }
      },
      "minecraft:horse_unsaddled": {
        "add": {
          "component_groups": ["minecraft:bugfixer"]
        },
        "queue_command": {
          "command": [" fill ~-3~-2~-3 ~3~4~3 air replace light_block_13"]
        },
        "remove": {
          "component_groups": ["minecraft:horse_saddled"]
        }
      },
      "minecraft:bugfix": {
        "add": {
          "component_groups": ["minecraft:vehicle"]
        },
        "remove": {
          "component_groups": ["minecraft:bugfixer"]
        }
      },
      "simple_vehicles:light_off": {
        "queue_command": {
          "command": [" fill ~-3~-2~-3 ~3~4~3 air replace light_block_13"]
        }
      },
      "simple_vehicles:light_on": {
        "queue_command": {
          "command": [
            "fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "setblock ~~1~ light_block_13 [] keep",
            "fill ~-3~-2~-3 ~3~-1~3 air replace light_block_13",
            "fill ~-3~3~-3 ~3~4~3 air replace light_block_13",
            "fill ~-3~-2~2 ~3~4~3 air replace light_block_13",
            "fill ~-3~-2~-2 ~3~4~-3 air replace light_block_13",
            "fill ~-3~-2~-3 ~-2~4~3 air replace light_block_13",
            "fill ~2~-2~-3 ~3~4~3 air replace light_block_13"
          ]
        }
      },
      "simple_vehicles:refuel": {
        "add": {
          "component_groups": ["simple_vehicles:refueled"]
        }
      },
      "simple_vehicles:refuel_re": {
        "add": {
          "component_groups": ["simple_vehicles:refuel"]
        },
        "remove": {
          "component_groups": ["simple_vehicles:refueled"]
        }
      }
    }
  }
}
