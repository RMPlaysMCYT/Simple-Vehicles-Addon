        "minecraft:interact": {
          "interactions": [
            {
              "interact_text": "Fuel It Up!!",
              "on_interact": {
                "event": "simple_vehicles:refuel",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "value": "simple_vehicles:gas_nozzle"
                    }
                  ]
                }
              },
              "use_item": false
            },
            {
              "interact_text": "Fuel It Up!!",
              "on_interact": {
                "event": "simple_vehicles:refuel",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "value": "simple_vehicles:jerry_can"
                    }
                  ]
                }
              },
              "use_item": true
            }
          ]
        },
        "minecraft:rideable": {
          "controlling_seat": 0,
          "crouching_skip_interact": true,
          "family_types": ["player"],
          "interact_text": "action.hint.ride.vehicle",
          "pull_in_entities": false,
          "rider_can_interact": false,
          "seat_count": 2,
          "seats": [
            {
              "position": [0, 0.75, 0]
            },
            {
              "position": [0, 0.75, -0.6]
            }
          ]
        }
      },
      "simple_vehicles:activated": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "has_tag",
                    "operator": "equals",
                    "value": "remove"
                  },
                  {
                    "test": "hourly_clock_time",
                    "operator": ">=",
                    "value": 0
                  },
                  {
                    "test": "hourly_clock_time",
                    "operator": "<",
                    "value": 12000
                  }
                ]
              },
              "event": "simple_vehicles:light_off"
            },
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      {
                        "all_of": [
                          {
                            "test": "hourly_clock_time",
                            "operator": ">=",
                            "value": 12000
                          },
                          {
                            "test": "hourly_clock_time",
                            "operator": "<",
                            "value": 24000
                          }
                        ]
                      },
                      {
                        "test": "light_level",
                        "operator": "<",
                        "value": 8
                      }
                    ]
                  },
                  {
                    "test": "has_tag",
                    "operator": "not",
                    "value": "remove"
                  }
                ]
              },
              "event": "simple_vehicles:light_on"
            }
          ]
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:movement": {
          "value": 0.3
        },
        "minecraft:is_tamed": {},
        "minecraft:can_power_jump": {},
        "minecraft:horse.jump_strength": {
          "value": 0.01
        }
      },
      "simple_vehicles:not_worked_on_water": {
