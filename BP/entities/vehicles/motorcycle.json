            "fill ~-3~-2~-3 ~3~-1~3 air replace light_block_13",
            "fill ~-3~3~-3 ~3~4~3 air replace light_block_13",
            "fill ~-3~-2~2 ~3~4~3 air replace light_block_13",
            "fill ~-3~-2~-2 ~3~4~-3 air replace light_block_13",
            "fill ~-3~-2~-3 ~-2~4~3 air replace light_block_13",
            "fill ~2~-2~-3 ~3~4~3 air replace light_block_13"
          ]
