{
    "format_version": "1.10.0",
    "animation_controllers": {
		"controller.animation.gliding_pane.plyride": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"riding": "query.has_rider"
						}
					]
				},
				"riding": {
					"transitions": [
						{
							"default": "!query.has_rider"
						}
					],
					"on_entry": [
						"/function player_ride_sys/player_ride_glidplane"
					]
				}
			}
		},
        "controller.animation.gliding_pane.fly": {
            "states": {
                "flying_v1": {
                    "transitions": [
                        {
                            "flying_v2": "query.is_saddled&&!query.is_on_ground&&math.random(1,10)>8"
                        },
                        {
                            "walking_v1": "query.is_on_ground"
                        }
                    ],
                    "on_entry": [
                        "/function flying_function/glidingplane"
                    ]
                },
                "flying_v2": {
                    "transitions": [
                        {
                            "flying_v1": "query.is_saddled&&!query.is_on_ground&&math.random(1,10)>8"
                        }
                    ],
                    "on_entry": [
                        "/function flying_function/glidingplane"
                    ]
                },
                "walking_v1": {
                    "transitions": [
                        {
                            "flying_v1": "!query.is_on_ground && query.is_saddled"
                        },
                        {
                            "walking_v2": "query.is_on_ground"
                        }
                    ],
                    "on_entry": [
                        "/function helicopter_walk"
                    ]
                },
                "walking_v2": {
                    "transitions": [
                        {
                            "walking_v1": "math.random(1,10)>8"
                        }
                    ]
                }
            }
        }
    }
}