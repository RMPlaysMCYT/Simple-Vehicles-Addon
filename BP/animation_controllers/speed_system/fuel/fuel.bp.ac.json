{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.simple_vehicles.fuel": {
			"states": {
				"default": {
					"transitions": [
						{
							"execute_command_id_1": "query.variant == 1"
						}
					]
				},
				"execute_command_id_1": {
					"transitions": [
						{
							"default": "query.variant != 1"
						}
					],
					"on_entry": [
						"/scoreboard players add @s oil 100",
						"/playsound random.potion.brewed @a[r=30] ~ ~ ~",
						"/particle minecraft:totem_particle ~ ~1 ~",
						"@s simple_vehicles:refuel_re"
					]
				}
			}
		}
	}
}