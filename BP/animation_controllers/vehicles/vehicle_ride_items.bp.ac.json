{
"format_version": "1.10.0",
  "animation_controllers":{
	"controller.animation.vehicle_ride.item_setpack": {
	  "initial_state": "default",
	  "states": {
	    "default": {
	      "transitions": [
	  	    {"given_ride": "query.has_rider"},
	  		{"taken_notride": "!query.has_rider"}
	  	  ]
	    },
	    "given_ride": {
	      "transitions": [
	  	    {"taken_notride": "!query.has_rider"}
	      ],
	      "on_entry": [
	  	    "/tag @p[c=1] add SimVehRide",
			"/function item_essentials",
	  	    "/tellraw @p[c=1] {\"rawtext\":[{\"translate\":\"action.hint.honk.vehicle\"}]}"
	      ]
	    },
	    "taken_notride": {
	      "transitions": [
	  	    {"given_ride": "query.has_rider"}
	      ],
	      "on_entry": [
			"/function item_essentials_cleared",
	  	    "/tag @p[c=1] remove SimVehRide"
	      ]
	    }
	  }
	},

	"controller.animation.bus_ride.item_setpack": {
	  "initial_state": "default",
	  "states": {
	    "default": {
	      "transitions": [
	  	    {"given_ride": "query.has_rider"},
	  		{"taken_notride": "!query.has_rider"}
	  	  ]
	    },
	    "given_ride": {
	      "transitions": [
	  	    {"taken_notride": "!query.has_rider"}
	      ],
	      "on_entry": [
	  	    "/tag @p[c=1] add BusRide",
			"/function item_essentials",
	  	    "/tellraw @p[c=1] {\"rawtext\":[{\"translate\":\"action.hint.honk.vehicle\"}]}"
	      ]
	    },
	    "taken_notride": {
	      "transitions": [
	  	    {"given_ride": "query.has_rider"}
	      ],
	      "on_entry": [
			"/function item_essentials_cleared",
	  	    "/tag @p[c=1] remove BusRide"
	      ]
	    }
	  }
	}
  }
}