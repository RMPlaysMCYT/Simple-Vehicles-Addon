      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall"
          }
        ]
      },
      "minecraft:underwater_movement": {
        "value": 0.1
      },
      "minecraft:healable": {
        "items": [
          {
            "item": "simple_vehicles:wrench",
            "heal_amount": 100,
            "effects": [
              {
                "name": "absorption",
                "chance": 0.8,
                "duration": 5,
                "amplifier": 5
              }
            ]
          }
        ],
        "force_use": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["minecraft:vehicle"]
        }
      },
      "simple_vehicles:remove_vehicle": {
        "queue_command": {
          "command": [
            "tag @s add remove",
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "kill @s"
          ]
        }
      },
      "minecraft:horse_saddled": {
        "add": {
          "component_groups": ["minecraft:horse_saddled"]
        },
        "queue_command": {
          "command": [
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "setblock ~~1~ light_block 13 keep",
            "fill ~-3~-2~-3 ~3~-1~3 air 0 replace light_block 13",
            "fill ~-3~3~-3 ~3~4~3 air 0 replace light_block 13",
            "fill ~-3~-2~2 ~3~4~3 air 0 replace light_block 13",
            "fill ~-3~-2~-2 ~3~4~-3 air 0 replace light_block 13",
            "fill ~-3~-2~-3 ~-2~4~3 air 0 replace light_block 13",
            "fill ~2~-2~-3 ~3~4~3 air 0 replace light_block 13"
          ]
        }
      },
      "minecraft:horse_unsaddled": {
        "queue_command": {
          "command": [" fill ~-3~-2~-3 ~3~4~3 air replace light_block_13"]
        },
        "remove": {
          "component_groups": ["minecraft:horse_saddled"]
        }
      },
      "sfp:light_off": {
        "queue_command": {
          "command": [" fill ~-3~-2~-3 ~3~4~3 air replace light_block_13"]
        }
      },
      "sfp:light_on": {
        "queue_command": {
          "command": [
            " fill ~-3~-2~-3 ~3~4~3 air replace light_block_13",
            "setblock ~~1~ light_block 13 keep",
            "fill ~-3~-2~-3 ~3~-1~3 air 0 replace light_block 13",
            "fill ~-3~3~-3 ~3~4~3 air 0 replace light_block 13",
            "fill ~-3~-2~2 ~3~4~3 air 0 replace light_block 13",
            "fill ~-3~-2~-2 ~3~4~-3 air 0 replace light_block 13",
            "fill ~-3~-2~-3 ~-2~4~3 air 0 replace light_block 13",
            "fill ~2~-2~-3 ~3~4~3 air 0 replace light_block 13"
          ]
        }
      }
    }
  }
}
