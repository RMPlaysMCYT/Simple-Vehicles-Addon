{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "simple_vehicles:armored_truck",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/armored_truck"
			},
			"geometry": {
				"default": "geometry.armored_truck"
			},
			"spawn_egg": {
				"texture": "vehicles_2",
				"texture_index": 8
			},
			"animations": {
				"move": "animation.armored_truck.move",
				"setup": "animation.armored_truck.setup",
				"wipe": "animation.armored_truck.wipe",
				"doors_idle": "animation.armored_truck.doors_idle",
				"close2": "animation.armored_truck.close2",
				"open": "animation.armored_truck.open",
				"close": "animation.armored_truck.close",
				"turn": "animation.armored_truck.turn",
				"v_turn": "controller.animation.vehicle.v_turn",
				"door_mechanic": "controller.animation.armored_truck.door_mechanica_v2",
				////Climb
				"up": "animation.chrysler_windsor.up",
				"down": "animation.chrysler_windsor.down",
				"general": "controller.animation.chrysler_windsor.general"
			},
			"scripts": {
        
				"initialize": [
					"variable.move_up = 0;",
					"variable.move_down = 0;",
					"variable.steering = 0;"
				],
				"animate": [
					"general",
					"v_turn",
					"door_mechanic",
					{
						"move": "query.modified_move_speed"
					},
					"setup",
					{
						"wipe": "query.is_in_water_or_rain&&query.is_saddled&&query.has_rider"
					}
				]
			},
			"render_controllers": [
				"controller.render.rancher"
			],
			"sound_effects": {
				"armored_truck_door_open": "simple_vehicles.corolla.open",
				"armored_truck_door_close": "simple_vehicles.corolla.close"
			}
		}
	}
}