{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "simple_vehicles:vintage_bus_a",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/vintage_bus_a"
			},
			"geometry": {
				"default": "geometry.vintage_bus_a"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
                "move": "animation.vintage_bus_a.move",
                "steer": "animation.vintage_bus_a.steer",
                "doors_idle": "animation.vintage_bus_a.doors_idle",
                "open": "animation.vintage_bus_a.open",
                "close": "animation.vintage_bus_a.close",
                "close2": "animation.vintage_bus_a.close2",
                "door_mech": "controller.animation.vintage_bus_a.door_mechanic",
