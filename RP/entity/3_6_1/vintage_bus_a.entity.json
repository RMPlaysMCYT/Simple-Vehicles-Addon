				"up": "animation.chrysler_windsor.up",
				"down": "animation.chrysler_windsor.down",
				"general": "controller.animation.chrysler_windsor.general"
			},
			"scripts": {
				"initialize": [
					"variable.steering = 0;"
				],
				"pre_animation": [
					"query.has_rider ? (variable.steering = Math.lerp(variable.steering, query.yaw_speed, 0.15));"
				],
				"animate": [
					"general",
					"move",
                    "steer",
                    "door_mech"
				]
			},
			"spawn_egg": {
				"texture": "vehicles_3",
                "texture_index": 22
			}
		}
	}
