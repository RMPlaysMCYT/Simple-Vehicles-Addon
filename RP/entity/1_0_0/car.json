{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "simple_vehicles:car",
      "materials": {
        "default": "witch",
        "car_lights": "entity_alphablend"
      },
      "geometry": {
        "default": "geometry.car_new",
        "car_lights": "geometry.car_lights"
      },
      "textures": {
        "black": "textures/entity/car",
        "white": "textures/entity/car/car_white",
        "orange": "textures/entity/car/car_naranja",
        "magenta": "textures/entity/car/car_magenta",
        "light_blue": "textures/entity/car/car_light_blue",
        "yellow": "textures/entity/car/car_yellow",
        "lime": "textures/entity/car/car_lime",
        "pink": "textures/entity/car/car_pink",
        "gray": "textures/entity/car/car_grey",
        "silver": "textures/entity/car/car_silver",
        "cyan": "textures/entity/car/car_cyan",
        "purple": "textures/entity/car/car_purple",
        "blue": "textures/entity/car/car_blue",
        "brown": "textures/entity/car/car_cafe",
        "green": "textures/entity/car/car_green",
        "red": "textures/entity/car/car_red",
        "car_lights": "textures/entity/vehi_lights/car_lights"
      },
      "spawn_egg": {
        "texture": "vehicles",
        "texture_index": 4
      },
      "animations": {
        "move": "animation.simple_vehicles.car_new.move",
        "turn": "animation.car.turn",
        "door_idle": "animation.simple_vehicles.car_new.door_idle",
        "open": "animation.simple_vehicles.car_new.open",
        "close": "animation.simple_vehicles.car_new.close",
        "close2": "animation.simple_vehicles.car_new.close2",
        "general": "controller.animation.vehicle.v_turn",				
        "door_mechanic_v2": "controller.animation.bus_v2.door_mechanic_v2",
        ////Climb
        "up": "animation.chrysler_windsor.up",
        "down": "animation.chrysler_windsor.down",
        "general2": "controller.animation.chrysler_windsor.general"
      },
      "render_controllers": [
        "controller.render.simple_car"
      ],
      "scripts": {
				"initialize": [
					"variable.steering = 0;"
				],
        "animate": [
          {
            "move": "query.modified_move_speed"
          },
          {
            "close2": "query.has_rider"
          },
          "general",
          "general2",
          "door_mechanic_v2"
        ]
      },
      "sound_effects": {
        "car_door_open": "simple_vehicles.car.open",
        "car_door_close": "simple_vehicles.car.close"
      },
      "particle_effects": {
        "arrow_particle": "simple_vehicles:arrow_spell_emitter"
      }
    }
  }
}