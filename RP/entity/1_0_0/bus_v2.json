{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "simple_vehicles:bus_2",
      "materials": {
        "default": "witch"
      },
      "textures": {
        "default": "textures/entity/bus_v2"
      },
      "geometry": {
        "default": "geometry.bus_v2"
      },
      "spawn_egg": {
        "texture": "vehicles",
        "texture_index": 3
      },
      "animations": {
        "move": "animation.simple_vehicles.bus_v2.move",
        "turn": "animation.bus_v2.turn",				
        "door_mechanic_v2": "controller.animation.bus_v2.door_mechanic_v2",
        "close": "animation.simple_vehicles.bus_v2.close",
        "close2": "animation.simple_vehicles.bus_v2.close2",
        "open": "animation.simple_vehicles.bus_v2.open",
        "v_turn": "controller.animation.vehicle.v_turn",
        "wiper": "animation.simple_vehicles.bus_v2.wiper"
      },
      "scripts": {
				"initialize": [
					"variable.steering = 0;"
				],
        "animate": [
          "v_turn",
          "move",
          "door_mechanic_v2",
          {
            "wiper": "query.is_in_water_or_rain && query.is_saddled && query.has_rider"
          }
        ]
      },
      "particle_effects": {
        "arrow_particle": "simple_vehicles:arrow_spell_emitter"
      },
      "render_controllers": [
        "controller.render.bus"
      ],
      "sound_effects": {
        "bus_v2_door_open": "simple_vehicles.bus_v2.open",
        "bus_v2_door_close": "simple_vehicles.bus_v2.close",
        "bus_v2.wiper": "simple_vehicles.bus_v2.wiper"
      }
    }
  }
}