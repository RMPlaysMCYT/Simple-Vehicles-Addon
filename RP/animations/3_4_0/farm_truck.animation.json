{
	"format_version": "1.8.0",
	"animations": {
		"animation.farm_truck.move": {
			"loop": true,
			"bones": {
				"wheel0": {
					"rotation": ["query.modified_distance_moved * 20", 0, 0]
				},
				"wheel3": {
					"rotation": ["query.modified_distance_moved * 20", 0, 0]
				},
				"wheel1": {
					"rotation": ["query.modified_distance_moved * 20", "variable.steering / 10", 0]
				},
				"wheel2": {
					"rotation": ["query.modified_distance_moved * 20", "variable.steering / 10", 0]
				},
				"steering_wheel": {
					"rotation": [0, 0, "variable.steering * -0.6"]
				},
				"body": {
					"rotation": [0, 0, "variable.steering * 0.01"]
				}
			}
		},
		"animation.farm_truck.open": {
			"loop": "hold_on_last_frame",
			"animation_length": 1,
			"bones": {
				"door0": {
					"rotation": {
						"0.0": [0, 0, 0],
						"1.0": [0, -65, 0]
					}
				},
				"door1": {
					"rotation": {
						"0.0": [0, 0, 0],
						"1.0": [0, 65, 0]
					}
				}
			}
		},
		"animation.farm_truck.close": {
			"loop": "hold_on_last_frame",
			"animation_length": 1,
			"bones": {
				"door0": {
					"rotation": {
						"0.0": [0, -65, 0],
						"1.0": [0, 0, 0]
					}
				},
				"door1": {
					"rotation": {
						"0.0": [0, 65, 0],
						"1.0": [0, 0, 0]
					}
				}
			}
		},
		"animation.farm_truck.close2": {
			"loop": "hold_on_last_frame",
			"animation_length": 1,
			"bones": {
				"door0": {
					"rotation": [0, 65, 0]
				},
				"door1": {
					"rotation": [0, -65, 0]
				}
			}
		}
	}
}