			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leg0": {
					"rotation": ["query.anim_time*10", 0, 0]
				},
				"leg1": {
					"rotation": ["query.anim_time*10", 0, 0]
				}
			}
		},
		"animation.sabre.open": {
			"loop": "hold_on_last_frame",
