				"door1": {
					"rotation": {
						"0.0": [0, 40, 0],
						"1.0": [0, 0, 0]
					}
				},
				"door0": {
					"rotation": {
						"0.0": [0, -40, 0],
						"1.0": [0, 0, 0]
