{
	"format_version": "1.8.0",
	"animations": {
		"animation.tractor.move": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"wheel1": {
					"rotation": ["query.anim_time * 15", 0, 0]
				},
				"tire0": {
					"rotation": ["query.anim_time * 15", 0, 0]
				},
				"tire1": {
					"rotation": ["query.anim_time * 15", 0, 0]
				}
			}
		},
		"animation.simple_vehicles.tractor.turn": {
			"loop": true,
			"bones": {
				"steer": {
					"rotation": [0, "math.max(-28,math.min(28,query.yaw_speed*0.5))*query.modified_move_speed*0.7", 0]
				},
				"tire0": {
					"rotation": [0, "math.max(-28,math.min(28,query.yaw_speed*0.5))", 0]
				},
				"tire1": {
					"rotation": [0, "math.max(-28,math.min(28,query.yaw_speed*0.5))", 0]
				}
			}
		},
		"animation.tractor.turn": {
			"loop": true,
			"bones": {
				"steer": {
					"rotation": [0, 0, "math.max(-28,math.min(28,query.yaw_speed*0.5))*-query.modified_move_speed*0.7"]
				}
			}
		}
	}
}