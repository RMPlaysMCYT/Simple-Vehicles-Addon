{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.chrysler_windsor.door_mechanic": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["doors_idle"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					]
				},
				"close": {
					"animations": ["close"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					]
				},
				"open": {
					"animations": ["open"],
					"transitions": [
						{"close": "query.mark_variant == 1"},
						{"close2": "query.has_player_rider"}
					]
				},
				"close2": {
					"animations": ["close2"],
					"transitions": [
						{"open": "!query.has_player_rider"}
					]
				}
			}
		},
		"controller.animation.chrysler_windsor.general": {
			"states": {
				"default": {
					"animations": [
						{"up": "variable.move_up"},
						{"down": "variable.move_down"}
					],
					"variables": {
						"move_up": {
							"input": "query.ground_speed < 2.3"
						},
						"move_down": {
							"input": "query.ground_speed >= 2.3"
						}
					}
				}
			}
		},
		"controller.animation.chrysler_windsor.move_ctrl": {
			"initial_state": "idle",
			"states": {
				"move": {
					"animations": [
						"move"
					],
					"transitions": [
						{
							"move_rev": "query.ground_speed < 2.3"
						}
					]
				},
				"idle":{
					"animations": ["idle"],
					"transitions": [
						{"move": "query.ground_speed < 2.3"},
						{"move_rev": "query.ground_speed >= 2.3"}
					]
				},
				"move_rev":{
					"animations": [
						"move_rev"
					],
					"transitions": [
						{
							"move": "query.ground_speed >= 2.3"
						}
					]
				}
			}
		}
	}
}