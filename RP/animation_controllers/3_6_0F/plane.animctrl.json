{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.plane.flying": {
			"initial_state": "landing",
			"states": {
				"landing": {
					"animations": [
						"flying"
					],
					"transitions": [
						{
							"flying": "query.is_on_ground == 1"
						}
					],
					"blend_transition": 0.2
				},
				"flying": {
					"animations": [
						"landing"
					],
					"transitions": [
						{
							"landing": "query.is_on_ground == 0"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}