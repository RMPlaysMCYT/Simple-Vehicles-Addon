{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.vintage_bus_a.door_mechanic": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["doors_idle"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					]
				},
				"close": {
					"animations": ["close"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					]
				},
				"open": {
					"animations": ["open"],
					"transitions": [
						{"close": "query.mark_variant == 1"},
						{"close2": "query.has_player_rider"}
					]
				},
				"close2": {
					"animations": ["close2"],
					"transitions": [
						{"open": "!query.has_player_rider"}
					]
				}
			}
		}
	}
}