{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.vehicles2.general": {
			"states": {
				"default": {
					"variables": {
						"move_up": {
							"input": "query.ground_speed<2.3"
						},
						"move_down": {
							"input": "query.ground_speed>=2.3"
						}
					},
					"animations": [
						"turn",
						{
							"ups": "variable.move_up"
						},
						{
							"downs": "variable.move_down"
						}
					]
				}
			}
		}
	}
}