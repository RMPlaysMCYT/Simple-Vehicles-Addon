{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.bike.general": {
			"initial_state": "setup",
			"states": {
				"setup": {
					"animations": ["setup"],
					"transitions": [
						{"setup2": "query.has_player_rider"}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"setup2": {
					"animations": ["setup2"],
					"transitions": [
						{"setup": "!query.has_player_rider"}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				}
			}
		},
		"controller.animation.bike.move": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{"move_front": "q.ground_speed > 1.0"},
						{"move_back": "q.ground_speed < 1.0"}
					],
					"blend_transition": 0.2
				},
				"move_front": {
					"animations": ["move"],
					"transitions": [
						{"move_back": "q.ground_speed < 0.5"}
					],
					"blend_transition": 0.2
				},
				"move_back": {
					"animations": ["moverev"],
					"transitions": [
						{"move_front": "query.ground_speed > 0.5"}
					]
				}
			}
		}
	}
}