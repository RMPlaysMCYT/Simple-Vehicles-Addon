{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.cadillac_dts_2010.door_mechanic": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["door_idle"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					],
					"blend_via_shortest_path": true
				},
				"close": {
					"animations": ["close"],
					"transitions": [
						{"open": "query.mark_variant == 2"}
					],
					"blend_transition": 0.2
				},
				"open": {
					"animations": ["open"],
					"transitions": [
						{"close2": "query.has_player_rider"},
						{"close": "query.mark_variant == 1"}
					],
					"blend_transition": 0.1
				},
				"close2": {
					"animations": ["close2"],
					"transitions": [
						{"open": "!query.has_player_rider"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}