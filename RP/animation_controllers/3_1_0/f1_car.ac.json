{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.f1_car.general": {
			"states": {
				"default": {
					"variables": {
						"move_up": {
							"input": "query.ground_speed<2.3"
						},
						"move_down": {
							"input": "query.ground_speed>=2.3"
						}
					},
					"animations": [
						{
							"ups": "variable.move_up"
						},
						{
							"downs": "variable.move_down"
						},
						"turn"
					]
				}
			}
		},
		"controller.animation.f1_car.move_ac": {
			"states": {
				"default":{
					"animations": [
						"setup"
					],
					"transitions": [
						{
							"move": "query.ground_speed >= 1.0"
						}
					],
					"blend_transition": 0.2
				},
				"move":{
					"animations": [
						"move"
					],
					"transitions": [
						{
							"default": "query.ground_speed <= 1.0"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}