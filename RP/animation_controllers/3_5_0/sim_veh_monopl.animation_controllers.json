{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.sim_veh_monopl.fly_ctrl": {
			"states": {
				"default": {
					"animations": ["landing"],
					"transitions": [
						{"flying": "query.is_on_ground == 0"}
					],
					"blend_transition": 0.25
				},
				"flying": {
					"animations": ["flying"],
					"transitions": [
						{"default": "query.is_on_ground == 1"}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}